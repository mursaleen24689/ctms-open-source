# CTMS Consultancy Platform — content protection
# Prevents the web server from serving source files or internal folders.
# Schema files, includes, storage and tooling must never be downloadable.

Options -Indexes

# Refuse source and tooling files. README.md is the single documented
# exception, so the operator can read the instructions in a browser.
<FilesMatch "\.(sql|log|ini|json|lock|bak|sh|bat|ps1|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block source snapshots and editor backup copies, including names such as
# entry.php.codex-backup-YYYYMMDD which would otherwise be served as text.
<FilesMatch "\.codex-backup([.-].*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<Files "README.md">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# Never serve dotfiles (.env, .git and similar).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Internal folders are not reachable at all.
# uploads/ is the one exception: report photographs and micrographs have to be
# served to the browser. That folder has its own policy which forbids execution
# and refuses anything that is not an image.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(inc|sql|storage)/ - [F,L]
</IfModule>

# Security headers on every response from this application.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header unset X-Powered-By
</IfModule>

# Do not advertise PHP errors to the client.
<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
</IfModule>
