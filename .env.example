# Example-only settings. Copy to a private environment file and replace values.
CTMS_PROJECT_PATH=/ctms
CTMS_APACHE_ORIGIN=http://localhost

# Configure on the PHP server only; do not expose mail credentials to the browser.
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=ctms@example.org
MAIL_PASSWORD=replace-locally
MAIL_FROM_ADDRESS=ctms@example.org
MAIL_FROM_NAME=CTMS
